# Database
# For local development, use the individual DB_* variables below.
# For production (e.g. Render), set DATABASE_URL instead.
DATABASE_URL=

DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Session
SESSION_SECRET=

# Server
PORT=7000
NODE_ENV=development

# Frontend URL (for CORS in production)
FRONTEND_URL=
